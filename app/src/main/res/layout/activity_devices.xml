<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deviceRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="8dp" android:background="@color/device_bar">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold" android:textColor="@android:color/white"/>
        <TextView android:id="@+id/deviceCancelTransfer" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="64dp" android:gravity="center" android:paddingHorizontal="12dp" android:text="@string/cancel" android:textColor="@android:color/white" android:visibility="gone" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/deviceMenu" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more" app:tint="@android:color/white" android:contentDescription="@string/menu"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp">
        <TextView android:id="@+id/deviceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_device" android:textAppearance="@style/DeviceHeadline"/>
        <TextView android:id="@+id/deviceStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/device_secondary"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/scanDevice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/scan_qr" app:icon="@drawable/ic_device_qr" app:iconPadding="8dp" android:paddingStart="10dp" android:paddingEnd="10dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/addDevice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minHeight="56dp" android:text="@string/add_short" app:icon="@drawable/ic_plus_white_24" app:iconPadding="8dp" android:paddingStart="10dp" android:paddingEnd="10dp"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/DeviceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="@string/search_hint" app:endIconMode="clear_text" app:boxBackgroundColor="@color/device_field">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/deviceSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" android:textSize="16sp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/statusFilters" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true" app:chipSpacingHorizontal="8dp">
                <com.google.android.material.chip.Chip android:id="@+id/statusAll" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/status_all" app:ensureMinTouchTargetSize="true" app:checkedIconVisible="false" android:textColor="@color/device_chip_text" app:chipBackgroundColor="@color/device_chip_background"/>
                <com.google.android.material.chip.Chip android:id="@+id/statusActive" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_active" app:ensureMinTouchTargetSize="true" app:checkedIconVisible="false" android:textColor="@color/device_chip_text" app:chipBackgroundColor="@color/device_chip_background"/>
                <com.google.android.material.chip.Chip android:id="@+id/statusWriteOff" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_write_off" app:ensureMinTouchTargetSize="true" app:checkedIconVisible="false" android:textColor="@color/device_chip_text" app:chipBackgroundColor="@color/device_chip_background"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/locationFilters" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/filter_location" android:textAllCaps="false" android:textColor="@color/text_primary" android:paddingStart="0dp" android:paddingEnd="4dp"/>
            <Spinner android:id="@+id/deviceSort" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="8dp" android:contentDescription="@string/sort_label" android:popupBackground="@color/surface" android:spinnerMode="dropdown"/>
        </LinearLayout>
        <TextView android:id="@+id/deviceResultCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/device_secondary" android:layout_marginBottom="8dp" android:accessibilityLiveRegion="polite"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/deviceList" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="16dp" android:clipToPadding="false"/>
        <LinearLayout android:id="@+id/deviceEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="24dp">
            <TextView android:id="@+id/deviceEmptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="@style/DeviceScreenTitle"/>
            <TextView android:id="@+id/deviceEmptyBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textSize="16sp" android:textColor="@color/device_secondary"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/deviceRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/deviceLoading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/transferContinue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:minHeight="52dp" android:text="@string/continue_transfer" android:visibility="gone" />
</LinearLayout>
