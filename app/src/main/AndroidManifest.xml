<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:name=".DeviceManagerApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_device_launcher"
        android:roundIcon="@drawable/ic_device_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceManager">
        <activity android:name=".ui.DeviceEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.DeviceDetailsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.DeviceHistoryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.InventoryAuditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.DeviceTransferActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
        <activity android:name=".ui.DeviceListActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.QrActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.QrPortraitActivity" android:exported="false" android:screenOrientation="portrait" android:stateNotNeeded="true" />
    </application>
</manifest>
