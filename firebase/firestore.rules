rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function memberPath(workspaceId, userId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId);
    }

    function isMember(workspaceId) {
      return signedIn() && exists(memberPath(workspaceId, request.auth.uid));
    }

    function isOwner(workspaceId) {
      return isMember(workspaceId)
        && get(workspacePath(workspaceId)).data.ownerUid == request.auth.uid;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'schemaVersion', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == 1;
      allow get: if isMember(workspaceId);
      allow list: if false;
      allow update: if isOwner(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.keys().hasOnly(['ownerUid', 'schemaVersion', 'createdAt']);
      allow delete: if false;

      match /members/{memberId} {
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['role', 'joinedAt'])
          && ((request.resource.data.role == 'owner'
                && get(workspacePath(workspaceId)).data.ownerUid == memberId)
              || (request.resource.data.role == 'member'
                && get(workspacePath(workspaceId)).data.schemaVersion == 1));
        allow get: if signedIn() && (request.auth.uid == memberId || isMember(workspaceId));
        allow list: if isMember(workspaceId);
        allow update: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.role == resource.data.role
          && request.resource.data.keys().hasOnly(['role', 'joinedAt']);
        allow delete: if isOwner(workspaceId)
          && memberId != get(workspacePath(workspaceId)).data.ownerUid;
      }

      match /devices/{deviceId} {
        function validDevice() {
          return request.resource.data.keys().hasOnly([
              'name', 'inventoryNumber', 'serialNumber', 'category', 'organization',
              'building', 'room', 'responsible', 'notes', 'status', 'writeOffReason',
              'createdAt', 'updatedAt', 'deletedAt', 'previousCloudId'
            ])
            && request.resource.data.keys().hasAll([
              'name', 'inventoryNumber', 'serialNumber', 'category', 'organization',
              'building', 'room', 'responsible', 'notes', 'status', 'writeOffReason',
              'createdAt', 'updatedAt', 'deletedAt', 'previousCloudId'
            ])
            && request.resource.data.status in ['ACTIVE', 'NEEDS_REPAIR', 'BROKEN', 'WRITE_OFF']
            && request.resource.data.name is string
            && request.resource.data.inventoryNumber is string
            && request.resource.data.organization is string
            && request.resource.data.room is string
            && request.resource.data.createdAt is int
            && request.resource.data.updatedAt is int;
        }

        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId) && validDevice();
        allow delete: if isMember(workspaceId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
